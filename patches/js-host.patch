--- /dev/null
+++ b/modules/mono/runtime/web-host.post.js
@@ -0,0 +1,5 @@
+if (ENVIRONMENT_IS_PTHREAD) {
+  // .NET wraps this exported function to establish its thread identity.
+  // Emscripten 4's in-module worker dispatcher otherwise calls the local binding.
+  __emscripten_thread_init = (...args) => Module.__emscripten_thread_init(...args);
+}
diff --git a/modules/mono/runtime/web-host.pre.js b/modules/mono/runtime/web-host.pre.js
new file mode 100644
index 0000000..dde686c
--- /dev/null
+++ b/modules/mono/runtime/web-host.pre.js
@@ -0,0 +1,28 @@
+Module = moduleArg(Module);
+ENVIRONMENT_IS_PTHREAD = !!Module.ENVIRONMENT_IS_PTHREAD;
+const startupMethod = ENVIRONMENT_IS_PTHREAD ? "configureWorkerStartup" : "configureEmscriptenStartup";
+const configureDotnetStartup = Module.__dotnet_runtime[startupMethod];
+Module.__dotnet_runtime[startupMethod] = function(module) {
+  configureDotnetStartup(module);
+  const instantiate = module.instantiateWasm;
+  module.instantiateWasm = function(imports, receiveInstance) {
+    // .NET 10 waits for preInit before instantiating; Emscripten 4 awaits
+    // instantiation before running preInit. Preserve .NET's startup order.
+    if (ENVIRONMENT_IS_PTHREAD) {
+      // The .NET host supplies the compiled module to its own instantiate callback.
+      wasmModuleReceived = function() {};
+      self.onmessage({ data: module.godotWorkerLoad });
+      imports.env.memory = wasmMemory;
+      module.wasmMemory = wasmMemory;
+      module.__emscripten_thread_init = (...args) => wasmExports._emscripten_thread_init(...args);
+    }
+    const callbacks = module.preInit;
+    module.preInit = [];
+    for (const callback of callbacks) callback();
+    return instantiate(imports, (instance, compiledModule) => {
+      const dotnetThreadInit = module.__emscripten_thread_init;
+      receiveInstance(instance, compiledModule);
+      if (ENVIRONMENT_IS_PTHREAD) module.__emscripten_thread_init = dotnetThreadInit;
+    });
+  };
+};
